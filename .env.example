# ==========================================================
# Variables de entorno - digitalfix-ms-user (Plantilla)
# ==========================================================
# --- Base de datos Oracle Autonomous (con wallet) ---
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<alias>_high?TNS_ADMIN=./wallet
SPRING_DATASOURCE_USERNAME=<usuario_bd>
SPRING_DATASOURCE_PASSWORD=<contrasena_bd>

# Variables de compatibilidad
DB_URL=jdbc:oracle:thin:@<alias>_high?TNS_ADMIN=./wallet
DB_USERNAME=<usuario_bd>
DB_PASSWORD=<contrasena_bd>

# --- Microsoft Entra ID ---
AZURE_TENANT_ID=<tu_azure_tenant_id>
AZURE_CLIENT_ID=<tu_azure_client_id>

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Puerto local ---
SERVER_PORT=8082
PORT=8082
